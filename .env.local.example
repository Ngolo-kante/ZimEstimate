# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Product analytics. Optional: when unset, PostHog and the consent banner stay disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google sign-in. Optional: without it the app falls back to Supabase's OAuth
# redirect, which works but makes Google's sign-in screen name the Supabase host
# instead of ours. Set it and sign-in happens on our own origin. This is the
# same client id already configured in Supabase's Google provider, and it is
# public by design — it appears in the authorize URL either way.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Server secrets
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CSRF_SECRET=replace_with_a_long_random_string
REMINDER_DISPATCH_SECRET=replace_with_a_long_random_string
CRON_SECRET=replace_with_a_long_random_string
GOOGLE_GEMINI_API_KEY=your_gemini_api_key

# Reminder providers (configure only channels you want)
RESEND_API_KEY=re_xxx
REMINDER_EMAIL_FROM=ZimEstimate <noreply@yourdomain.com>
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_FROM=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TELEGRAM_BOT_TOKEN=123456789:AA...

# WhatsApp Cloud API (optional alternative to Twilio WhatsApp)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_TOKEN=EAAB...
